{%- macro profile_group(group) -%}
{{ require_group(group) }}
{%- for section in profile_sections if section.kind == group -%}
{%- set cls = schemaview.get_class(section.display) -%}
{%- set characteristic = section.target -%}
{%- set properties = schemaview.get_class(schemaview.induced_slot('properties', characteristic).range) if group == 'deployment' else none -%}
{%- set label = properties.title if group == 'deployment' else cls.title -%}
{{ ('## ' if group == 'deployment' else '### ') ~ cls.title ~ '\n\n' }}
{%- if cls.description %}{{ cls.description ~ '\n\n' }}{% endif -%}
{%- set key = schemaview.induced_slot('key', characteristic) -%}
{{ ('Key: `' ~ key.equals_string if key.equals_string is not none else 'Key pattern: `' ~ key.pattern) ~ '`\n\n' -}}
{{ ('### ' if group == 'deployment' else '#### ') ~ label ~ ' Properties Attributes\n\n' }}
{%- if group == 'deployment' -%}
{{ '> **Note:** ' ~ properties.description ~ '\n\n' }}
{%- else -%}
{{ '| Field      | Type            | Required?       | Description     |\n|------------|-----------------|-----------------|-----------------|\n' }}
{%- for slot in schemaview.class_induced_slots(cls.name) -%}
{{ '| ' ~ slot.name ~ ' | ' ~ ('enum' if schemaview.get_enum(slot.range) else 'number' if slot.range in ['float', 'double', 'integer', 'decimal'] else slot.range) ~ ' | ' ~ ('Y' if slot.required else 'N') ~ ' | ' ~ slot.description ~ ' |\n' }}
{%- endfor -%}
{{ '\n' }}
{%- endif -%}
{{ ('### ' if group == 'deployment' else '#### ') ~ label ~ ' Example\n\n```json\n' ~ profile_example(characteristic) ~ '\n```' }}
{%- if not loop.last %}{{ '\n\n' }}{% endif -%}
{%- endfor -%}
{%- endmacro -%}
